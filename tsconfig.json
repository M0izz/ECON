{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@econ/sdk": ["src/sdk/index.ts"],
      "@econ/sdk/*": ["src/sdk/*"],
      "@econ/settlement": ["src/settlement/index.ts"],
      "@econ/settlement/*": ["src/settlement/*"],
      "@econ/demo": ["src/demo/index.ts"],
      "@econ/demo/*": ["src/demo/*"]
    }
  },
  "include": ["src", "tests", "contracts"]
}

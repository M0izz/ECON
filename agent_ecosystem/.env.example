# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CREDIT_VAULT_ADDRESS=0xYourDeployedContractAddress

# One private key per agent — fund each with a little MON from the faucet
# for gas, and register each address via CreditVault.registerAgent()
SCOUT_PRIVATE_KEY=0x...
ANALYST_PRIVATE_KEY=0x...
EXECUTOR_PRIVATE_KEY=0x...

# Optional — leave blank to use the rule-based fallback instead of Gemini
GEMINI_API_KEY=

# Balance below which an agent is flagged as a GC sweep candidate
LOW_BALANCE_THRESHOLD=5

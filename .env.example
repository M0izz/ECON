# ECON Protocol Environment Configuration
# Dynamic Environment ID (public client-side variable)
VITE_DYNAMIC_ENVIRONMENT_ID=

# Server-Side Secrets (NEVER prefix with VITE_)
# Kept strictly server-side / proxy-only — never exposed to client bundles
NANSEN_API_KEY=
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
